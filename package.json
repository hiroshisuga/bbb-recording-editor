{
  "name": "bbb-recording-editor",
  "version": "0.1.0",
  "homepage": "/recording-editor",
  "dependencies": {
    "@bigbluebutton/tldraw": "^2.0.0-alpha.36",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-intl": "^6.2.5",
    "react-player": "^2.16.0",
    "recharts": "^2.12.7",
    "styled-components": "~6.3.12"
  },
  "devDependencies": {
    "react-scripts": "^5.0.1",
    "http-proxy-middleware": "^4.2.0"
  },
  "overrides": {
    "nth-check": "2.0.1",
    "@svgr/webpack": "6.5.1",
    "resolve-url-loader": "5.0.0",
    "postcss": "8.5.23",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "@tootallnate/once": "2.0.1",
    "webpack-dev-server": "4.15.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "BUILD_PATH=build-editor PUBLIC_URL=/recording-editor react-scripts build",
    "build:editor": "npm run build",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.*/)?nanoid/)",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiroshisuga/bbb-recording-editor.git"
  },
  "keywords": [
    "bigbluebutton",
    "recording-editor"
  ],
  "author": "Pedro Beschorner Marin <pedrobmarin@gmail.com>",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/hiroshisuga/bbb-recording-editor/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
